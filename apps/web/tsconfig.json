{
  "include": ["app/**/*", "tests/unit/**/*", "../../packages/shared/src/**/*", ".react-router/types/**/*", "*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "vite/client", "bun-types"],
    "rootDirs": [".", "./.react-router/types"]
  }
}
