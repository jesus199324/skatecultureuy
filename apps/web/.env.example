# Configuración pública del front (no son secretos: terminan en el navegador).
# Copiá este archivo como .env y completá los valores.

# URL pública del sitio (canónicas y vistas previas al compartir).
VITE_SITE_URL=https://skateculture.uy

# Nombre de la cuenta de Cloudinary. Vacío = se muestran los placeholders demo.
VITE_CLOUDINARY_CLOUD_NAME=
