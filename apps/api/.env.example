# API de SKATE CULTURE UY. Copiá este archivo como apps/api/.env
# (y como apps/api/.env.test para los tests, con otra base).

# PostgreSQL. Con Neon: Dashboard → tu proyecto → Connect → copiá la
# "connection string" (termina en ?sslmode=require).
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/scuy?sslmode=require

# Solo en .env.test: base de prueba que los tests vacían en cada corrida.
# En Neon conviene crear una rama (branch) "test" del proyecto.
# TEST_DATABASE_URL=postgresql://...

PORT=4000
NODE_ENV=development

# Orígenes que pueden llamar a la API desde el navegador (separados por coma).
CORS_ORIGIN=http://localhost:5173

# Pedidos por minuto y por IP.
RATE_LIMIT_PER_MINUTE=120

# Panel: días que dura una sesión y intentos de login fallidos cada 15 minutos.
SESSION_DAYS=7
LOGIN_ATTEMPTS=5
