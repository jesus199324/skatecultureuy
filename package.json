{
  "name": "skate-culture-uy",
  "private": true,
  "description": "SKATE CULTURE UY — revista digital de skateboarding uruguayo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "start:api": "npm run start -w apps/api",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "test": "npm run test -w apps/web && npm run test -w apps/api",
    "test:web": "npm run test -w apps/web",
    "test:api": "npm run test -w apps/api"
  }
}
